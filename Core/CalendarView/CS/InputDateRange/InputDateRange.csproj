<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="C1.Win.Accordion" Version="10.0.20262.*" />
    <PackageReference Include="C1.Win.Calendar" Version="10.0.20262.*" />
    <PackageReference Include="C1.Win.Input" Version="10.0.20262.*" />
    <PackageReference Include="C1.Win.InputPanel" Version="10.0.20262.*" />
    <PackageReference Include="C1.Win.List" Version="10.0.20262.*" />
    <PackageReference Include="C1.Win.Themes" Version="10.0.20262.*" />
  </ItemGroup>

</Project>