    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget>
    <ApplicationIcon>C1.ico</ApplicationIcon>
    <StartupObject>RowsSelected.MainForm</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Design" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="C1.Win.FlexGrid" Version="10.0.20262.*" />
    <PackageReference Include="C1.Win.Ribbon" Version="10.0.20262.*" />
    <PackageReference Include="C1.Win.Themes" Version="10.0.20262.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include=".sa3licx" />
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

</Project>
